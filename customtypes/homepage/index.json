{
  "format": "page",
  "id": "homepage",
  "label": "HomePage",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "herocarouseldata": {
        "type": "Group",
        "config": {
          "label": "HeroCarouselData",
          "repeat": true,
          "fields": {
            "herocarouselbackground": {
              "type": "Image",
              "config": {
                "label": "HeroCarouselBackground",
                "constraint": {},
                "thumbnails": []
              }
            },
            "herocarouseltitle": {
              "type": "Text",
              "config": {
                "label": "HeroCarouselTitle",
                "placeholder": "Slide Title (H2)"
              }
            },
            "herocarouseldescription": {
              "type": "Text",
              "config": {
                "label": "HeroCarouselDescription",
                "placeholder": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut..."
              }
            },
            "herocarousellink": {
              "type": "Link",
              "config": {
                "label": "HeroCarouselLink",
                "placeholder": "Slide Link",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {}
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
