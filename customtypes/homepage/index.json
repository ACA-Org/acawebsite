{
  "format": "page",
  "id": "homepage",
  "label": "HomePage",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "heroTitle": {
        "type": "StructuredText",
        "config": {
          "label": "HeroTitle",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "heading1,heading2,heading3,heading4,heading5,heading6"
        }
      },
      "heroSubTitle": {
        "type": "Text",
        "config": {
          "label": "HeroSubTitle",
          "placeholder": ""
        }
      },
      "heroAction": {
        "type": "Link",
        "config": {
          "label": "HeroAction",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": false
        }
      },
      "heroCarouselData": {
        "type": "Group",
        "config": {
          "label": "HeroCarouselData",
          "repeat": true,
          "fields": {
            "heroCarouselBackground": {
              "type": "Image",
              "config": {
                "label": "HeroCarouselBackground",
                "constraint": {},
                "thumbnails": []
              }
            },
            "heroCarouselTitle": {
              "type": "Text",
              "config": {
                "label": "HeroCarouselTitle",
                "placeholder": "Slide Title (H2)"
              }
            },
            "heroCarouselDescription": {
              "type": "Text",
              "config": {
                "label": "HeroCarouselDescription",
                "placeholder": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut..."
              }
            },
            "heroCarouselLink": {
              "type": "Link",
              "config": {
                "label": "HeroCarouselLink",
                "placeholder": "Slide Link",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            }
          }
        }
      },
      "nextConferenceInfo": {
        "type": "Link",
        "config": {
          "label": "NextConferenceInfo",
          "select": "document",
          "repeat": false,
          "customtypes": ["nextConferenceSection"]
        }
      },
      "introHeader": {
        "type": "Text",
        "config": {
          "label": "IntroHeader",
          "placeholder": "Our Mission: Excellence in Corrections"
        }
      },
      "introDescription": {
        "type": "Text",
        "config": {
          "label": "IntroDescription",
          "placeholder": "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium..."
        }
      },
      "introAction": {
        "type": "Link",
        "config": {
          "label": "IntroAction",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": false
        }
      },
      "introImageTile": {
        "type": "Group",
        "config": {
          "label": "IntroImageTile",
          "repeat": true,
          "fields": {
            "introImage1": {
              "type": "Image",
              "config": {
                "label": "IntroImage1",
                "constraint": {},
                "thumbnails": []
              }
            },
            "introImage2": {
              "type": "Image",
              "config": {
                "label": "introImage2",
                "constraint": {},
                "thumbnails": []
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "speedBump": {
              "type": "SharedSlice"
            },
            "social_carousel": {
              "type": "SharedSlice"
            },
            "carousel": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
