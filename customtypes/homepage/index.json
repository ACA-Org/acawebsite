{
  "format": "page",
  "id": "homepage",
  "label": "HomePage",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "heroEyebrowText": {
        "type": "Text",
        "config": {
          "label": "Hero Eyebrow Text",
          "placeholder": ""
        }
      },
      "heroTopTitle": {
        "type": "Text",
        "config": {
          "label": "Hero Top Title",
          "placeholder": ""
        }
      },
      "heroBottomTitle": {
        "type": "Text",
        "config": {
          "label": "Hero Bottom Title",
          "placeholder": ""
        }
      },
      "heroSubTitle": {
        "type": "Text",
        "config": {
          "label": "Hero Subtitle",
          "placeholder": ""
        }
      },
      "heroAction": {
        "type": "Link",
        "config": {
          "label": "Hero Action",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": false
        }
      },
      "heroCarouselData": {
        "type": "Group",
        "config": {
          "label": "Hero Carousel",
          "repeat": true,
          "fields": {
            "heroCarouselBackground": {
              "type": "Image",
              "config": {
                "label": "Card Background",
                "constraint": {},
                "thumbnails": [
                  {
                    "name": "mobile",
                    "width": 1080,
                    "height": 1920
                  }
                ]
              }
            },
            "heroCarouselTitle": {
              "type": "Text",
              "config": {
                "label": "Card Title",
                "placeholder": "Slide Title (H2)"
              }
            },
            "heroCarouselDescription": {
              "type": "Text",
              "config": {
                "label": "Card Description",
                "placeholder": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut..."
              }
            },
            "heroCarouselLink": {
              "type": "Link",
              "config": {
                "label": "Card Link",
                "placeholder": "Slide Link",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            }
          }
        }
      },
      "nextConferenceInfo": {
        "type": "Link",
        "config": {
          "label": "Next Conference Info",
          "select": "document",
          "repeat": false,
          "customtypes": ["nextConferenceSection"]
        }
      },
      "introHeader": {
        "type": "Text",
        "config": {
          "label": "Intro Header",
          "placeholder": "Our Mission: Excellence in Corrections"
        }
      },
      "introDescription": {
        "type": "Text",
        "config": {
          "label": "Intro Description",
          "placeholder": "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium..."
        }
      },
      "introAction": {
        "type": "Link",
        "config": {
          "label": "Intro Action",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": false
        }
      },
      "introImageTile": {
        "type": "Group",
        "config": {
          "label": "Intro Image Tile",
          "repeat": true,
          "fields": {
            "introImage1": {
              "type": "Image",
              "config": {
                "label": "Intro Image 1",
                "constraint": {},
                "thumbnails": []
              }
            },
            "introImage2": {
              "type": "Image",
              "config": {
                "label": "Intro Image 2",
                "constraint": {},
                "thumbnails": []
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "carousel": {
              "type": "SharedSlice"
            },
            "logo_ticker": {
              "type": "SharedSlice"
            },
            "speedBump": {
              "type": "SharedSlice"
            },
            "social_carousel": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
