{
  "format": "page",
  "id": "newsletterDetail",
  "label": "NewsletterDetail",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "newsBanner": {
        "type": "Image",
        "config": {
          "label": "News Banner",
          "constraint": {},
          "thumbnails": []
        }
      },
      "newsTitle": {
        "type": "Text",
        "config": {
          "label": "News Title",
          "placeholder": ""
        }
      },
      "newsContent": {
        "type": "StructuredText",
        "config": {
          "label": "News Content",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item"
        }
      },
      "requiresAuth": {
        "type": "Boolean",
        "config": {
          "label": "Requires Authentication",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": true
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "speedBump": {
              "type": "SharedSlice"
            },
            "image_callout": {
              "type": "SharedSlice"
            },
            "conference_card": {
              "type": "SharedSlice"
            },
            "card_container": {
              "type": "SharedSlice"
            },
            "tile_container": {
              "type": "SharedSlice"
            },
            "link_tile": {
              "type": "SharedSlice"
            },
            "logo_ticker": {
              "type": "SharedSlice"
            },
            "menu_item": {
              "type": "SharedSlice"
            },
            "accordion": {
              "type": "SharedSlice"
            },
            "contact_form": {
              "type": "SharedSlice"
            },
            "link_card": {
              "type": "SharedSlice"
            },
            "table": {
              "type": "SharedSlice"
            },
            "rich_text_box": {
              "type": "SharedSlice"
            },
            "button_group": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
