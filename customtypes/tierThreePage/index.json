{
  "format": "page",
  "id": "tierThreePage",
  "label": "TierThreePage",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "parentPage": {
        "type": "Link",
        "config": {
          "label": "ParentPage",
          "select": "document",
          "repeat": false,
          "customtypes": [
            "tierTwoPage"
          ]
        }
      },
      "pageImage": {
        "type": "Image",
        "config": {
          "label": "PageImage",
          "constraint": {},
          "thumbnails": []
        }
      },
      "pageTitle": {
        "type": "Text",
        "config": {
          "label": "PageTitle",
          "placeholder": ""
        }
      },
      "pageSubTitle": {
        "type": "Text",
        "config": {
          "label": "PageSubTitle",
          "placeholder": ""
        }
      },
      "pageContent": {
        "type": "StructuredText",
        "config": {
          "label": "PageContent",
          "placeholder": "",
          "allowTargetBlank": true,
          "labels": [
            "Block Quote"
          ],
          "multi": "paragraph,preformatted,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
        }
      },
      "hideFromRightMenu": {
        "type": "Boolean",
        "config": {
          "label": "Hide from Right Menu?",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": false
        }
      },
      "hidden": {
        "type": "Boolean",
        "config": {
          "label": "hidden",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": false
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "accordion": {
              "type": "SharedSlice"
            },
            "button_group": {
              "type": "SharedSlice"
            },
            "card_container": {
              "type": "SharedSlice"
            },
            "carousel": {
              "type": "SharedSlice"
            },
            "image_callout": {
              "type": "SharedSlice"
            },
            "link_tile": {
              "type": "SharedSlice"
            },
            "rich_text_box": {
              "type": "SharedSlice"
            },
            "speedBump": {
              "type": "SharedSlice"
            },
            "table": {
              "type": "SharedSlice"
            },
            "tile_container": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    },
    "PostContent": {
      "slices2": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "accordion": {
              "type": "SharedSlice"
            },
            "button_group": {
              "type": "SharedSlice"
            },
            "card_container": {
              "type": "SharedSlice"
            },
            "carousel": {
              "type": "SharedSlice"
            },
            "image_callout": {
              "type": "SharedSlice"
            },
            "link_tile": {
              "type": "SharedSlice"
            },
            "rich_text_box": {
              "type": "SharedSlice"
            },
            "speedBump": {
              "type": "SharedSlice"
            },
            "table": {
              "type": "SharedSlice"
            },
            "tile_container": {
              "type": "SharedSlice"
            }
          }
        }
      }
    }
  }
}