{
  "id": "accordion",
  "type": "SharedSlice",
  "name": "Accordion",
  "description": "Accordion",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "accordionHeading": {
          "type": "Text",
          "config": {
            "label": "AccordionHeading",
            "placeholder": "This is for an optional heading above the Accordion"
          }
        },
        "accordionContent": {
          "type": "Text",
          "config": {
            "label": "AccordionContent",
            "placeholder": "This is for some optional description text below the Accordion Heading"
          }
        },
        "accordionItems": {
          "type": "Group",
          "config": {
            "label": "AccordionItems",
            "repeat": true,
            "fields": {
              "accordionTitle": {
                "type": "Text",
                "config": {
                  "label": "AccordionTitle",
                  "placeholder": ""
                }
              },
              "accordionDescription": {
                "type": "StructuredText",
                "config": {
                  "label": "AccordionDescription",
                  "placeholder": "",
                  "allowTargetBlank": true,
                  "labels": ["Block Quote"],
                  "multi": "paragraph,heading3,heading4,heading5,heading6,strong,em,hyperlink,list-item,o-list-item"
                }
              },
              "accordionAction": {
                "type": "Link",
                "config": {
                  "label": "AccordionAction",
                  "placeholder": "",
                  "select": null,
                  "allowTargetBlank": true,
                  "allowText": true,
                  "repeat": false
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
